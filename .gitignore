# === secrets / env — NUNCA commitar o real, só .example ===
.env
*.pem
*.key
*.crt
config/airflow/connections.json
config/airflow/variables.json
!config/airflow/*.example.json
# NOTA: config/prometheus/prometheus.yml é versionado de propósito;
# scripts/bootstrap.sh rotaciona o bearer_token do MinIO in-place.
# Aceite o diff local após o bootstrap, não commite o token rotacionado.

