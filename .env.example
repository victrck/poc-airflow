# Copiado/atualizado por scripts/bootstrap.sh (gera segredos se ausentes).
# NUNCA commite o .env real.
# F0 - Pinned versions + smoke spec
# Airflow 3.x (FabAuthManager para RBAC por DAG), Hive 4.0, Trino 455, PG15
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8081/execution/
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=8
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__API_AUTH__JWT_SECRET=GERADO_NO_BOOTSTRAP_JWT
AIRFLOW__CORE__FERNET_KEY=GERADO_NO_BOOTSTRAP_FERNET
AIRFLOW__METRICS__STATSD_ON=True
AIRFLOW__METRICS__STATSD_HOST=statsd-exporter
AIRFLOW__METRICS__STATSD_PORT=9125
AIRFLOW__METRICS__STATSD_PREFIX=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow_db

# Postgres (3 DBs na mesma instância)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow_db
HIVE_DB=hive_metastore_db
HIVE_USER=hive
HIVE_PASSWORD=hive
ORGANIZACAO_DB=organizacaodb
ORGANIZACAO_USER=organizacao_user
ORGANIZACAO_PASSWORD=organizacao_password

# MinIO / Lakehouse (bucket organizacao = parity Mage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=organizacao
MINIO_LOCAL_DOMAIN=minio:9000
MINIO_SECURE=False

# Processamento (parity Mage)
PROCESSING_PERIODO=
PROCESSING_ESTADO=MA
UFS_BRASIL=MA
MAGE_TEMP_DIR=/tmp/mage
DUCKDB_MEMORY_LIMIT_GB=2.0
DUCKDB_THREADS=2
ORG_POSTGRES_BATCH_SIZE=50000
TRINO_CATALOG=iceberg
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin

# Hive Metastore S3A
S3_ENDPOINT_URL=http://minio:9000


# Secrets backend (Connections/Variables via arquivos, montados ro só no scheduler).
# Ordem de leitura: arquivo > AIRFLOW_VAR_*/AIRFLOW_CONN_* > metastore DB.
AIRFLOW__SECRETS__BACKEND=airflow.secrets.local_filesystem.LocalFilesystemBackend
AIRFLOW__SECRETS__BACKEND_KWARGS={"variables_file_path":"/opt/airflow/secrets/variables.json","connections_file_path":"/opt/airflow/secrets/connections.json"}

# Grupo do docker.sock no host (bootstrap preenche; dá acesso Docker-out-of-Docker)
DOCKER_GID=GERADO_NO_BOOTSTRAP_GID
