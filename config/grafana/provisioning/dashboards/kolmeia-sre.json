{
  "title": "Kolmeia SRE \u2014 Pipelines",
  "uid": "kolmeia-sre",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DAG runs falhos (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(airflow_ti_failures[24h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DAG runs sucesso (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(airflow_dagrun_duration_success_count[24h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Falhas por DAG (24h)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (dag) (increase(airflow_dagrun_duration_success_count[24h]))",
          "legendFormat": "{{dag}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dura\u00e7\u00e3o m\u00e9dia de task por task",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(airflow_task_scheduled_duration{quantile=\"0.5\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Scheduler heartbeat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "airflow_scheduler_heartbeat"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pool slots abertos (heavy_duckdb)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "airflow_pool_open_slots",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tasks na fila do executor",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "airflow_executor_queued_tasks"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU por container (%)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mem\u00f3ria por container",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{image!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Servi\u00e7os UP",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(up)"
        }
      ]
    }
  ]
}